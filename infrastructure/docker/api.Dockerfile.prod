# Image de PRODUCTION pour apps/api (étape 16) — build TypeScript puis
# exécution de JavaScript compilé pur (`node dist/server.js`). Distincte de
# `api.Dockerfile` (développement, `tsx watch`, code monté en volume) :
# celui-ci reste inchangé et continue de servir le workflow de dev local.
# Aucun volume de source n'est prévu pour cette image — le code est copié
# et compilé une fois pour toutes au moment du build.
FROM node:22-alpine

# Requis par le moteur Prisma sur Alpine (détection correcte d'OpenSSL),
# comme pour l'image de développement.
RUN apk add --no-cache openssl

WORKDIR /workspace

COPY package.json package-lock.json* ./
COPY apps/api/package.json apps/api/package.json

RUN npm install

COPY apps/api apps/api
COPY tsconfig.base.json tsconfig.base.json

WORKDIR /workspace/apps/api

RUN npx prisma generate
RUN npm run build

ENV NODE_ENV=production

# Utilisateur non-root fourni par l'image officielle node:*-alpine (uid
# 1000) : les fichiers copiés ci-dessus restent lisibles par cet
# utilisateur (permissions par défaut de COPY), et l'exécution ne requiert
# aucune écriture sur le système de fichiers.
USER node

EXPOSE 4000

# Jamais `tsx watch` ici : uniquement le JavaScript compilé par `npm run
# build` ci-dessus. Les migrations Prisma (`prisma migrate deploy`) et le
# seed restent des étapes manuelles distinctes, jamais exécutées au
# démarrage du conteneur (voir docs/deployment/README.md).
CMD ["node", "dist/server.js"]
