# ---------------------------------------------------------------------------
# MediLink AI - Variables d'environnement (exemple)
# Copier ce fichier en ".env" et renseigner de VRAIES valeurs en local.
# Ne jamais committer le fichier ".env" (voir .gitignore).
# ---------------------------------------------------------------------------

# --- PostgreSQL (utilisé par docker-compose et par Prisma) ---
# Port hôte 5540 (ni 5432 ni 5433/5434) pour éviter tout conflit avec une
# instance PostgreSQL déjà installée nativement, ou avec d'autres projets
# Docker présents sur la machine.
POSTGRES_USER=medilink
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medilink
POSTGRES_PORT=5540

# URL de connexion consommée par Prisma (apps/api)
# En local (api hors Docker) -> host "localhost", port 5540
# Dans docker-compose (api dans le réseau Docker) -> host "postgres", port 5432
DATABASE_URL=postgresql://medilink:change-me@localhost:5540/medilink

# Connexion DIRECTE (jamais via un pooler), utilisée uniquement par les
# commandes `prisma migrate`. En local (pas de pooler), même valeur que
# DATABASE_URL. Avec un PostgreSQL managé exposant une connexion "pooled"
# (ex. Supabase + PgBouncer) pour DATABASE_URL, DIRECT_URL doit pointer vers
# la connexion directe fournie séparément par la plateforme.
DIRECT_URL=postgresql://medilink:change-me@localhost:5540/medilink

# Base séparée utilisée par la suite de tests (npm run test:api), pour ne
# jamais polluer la base de développement/seed avec des données de test.
TEST_DATABASE_URL=postgresql://medilink:change-me@localhost:5540/medilink_test

# --- API (apps/api) ---
API_PORT=4000
NODE_ENV=development

# Secret de signature des access tokens JWT (générer une valeur aléatoire
# forte, ex: `openssl rand -hex 32` ; ne jamais réutiliser cet exemple).
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_ACCESS_EXPIRES_IN=15m

# Les refresh tokens ne sont PAS des JWT : ce sont des jetons aléatoires
# opaques, transmis via cookie httpOnly, dont seul le hash est stocké en
# base (rotation à chaque utilisation). Pas de secret JWT dédié nécessaire.
REFRESH_TOKEN_TTL_DAYS=30

# Secret de signature des cookies (défense en profondeur, en plus du hash
# stocké en base). Générer une valeur aléatoire forte.
COOKIE_SECRET=replace-with-a-long-random-value

# Liste blanche CORS (étape 16), origines séparées par des virgules, sans
# espace superflu. Optionnelle : si absente, l'API reflète l'origine de la
# requête (`origin: true`) — pratique en développement, mais À TOUJOURS
# DÉFINIR EXPLICITEMENT en production avec le(s) domaine(s) réel(s) du
# frontend. Ne jamais remplacer l'exemple ci-dessous par un domaine réel
# dans ce fichier (uniquement dans le ".env" local/de déploiement).
# CORS_ORIGIN=https://medilink.example,https://www.medilink.example

# --- Notifications (étape 14) ---
# Optionnel : sans SMTP_HOST, l'API n'envoie aucun email réel (transport
# "no-op"), utile en dev/CI. Pour tester réellement l'envoi en local, lancer
# Mailpit (`docker compose --profile mail up`) et décommenter ces valeurs.
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@medilink.local

# Fréquence (ms) du balayage des rappels de rendez-vous (scheduler
# in-process, pas de cron externe ni de file d'attente).
REMINDER_CHECK_INTERVAL_MS=900000

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_PORT=3000
